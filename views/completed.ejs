<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Completed Tasks</title>
    <link rel="stylesheet" href="/completed.css">
</head>
<body>

    <div class="tasks-container">
    <h1>Completed Tasks</h1>

    <% for(let i=0; i<tasks.length; i++){ %>

    <div class="task-card">

        <span>
            <input
                type="checkbox"
                class="undo-checkbox"
                data-id="<%= tasks[i].id %>"
            >
             <span class="undo-label">Undo</span>
        </span>

        <span
            class="task-title"
            data-description="<%= tasks[i].description %>"
        >
            <%= tasks[i].title %>
        </span>

        <span class="task-date">
            <%= tasks[i].deadline.toLocaleDateString() %>
        </span>

        <button
            class="edit-btn"
            data-id="<%= tasks[i].id %>"
            data-title="<%= tasks[i].title %>"
            data-description="<%= tasks[i].description %>"
            data-priority="<%= tasks[i].priority %>"
            data-deadline="<%= tasks[i].deadline.toISOString().split('T')[0] %>"
        >
            Edit
        </button>

        <form action="/delete/<%= tasks[i].id %>" method="post">
            <button type="submit">
                Delete
            </button>
        </form>

    </div>

    <% } %>

    <div class="completed-page">
        <a href="/">← Back to Tasks</a>
    </div>

</div>
<div id="edit-modal">
        <div id="edit-modal-content">
            <h2>Edit Task</h2>
            <input type="hidden" id="edit-id">
            <label>Title</label>
            <input type="text" id="edit-title">
            <label>Description</label>
            <textarea id="edit-description"></textarea>
            <label>Deadline</label>
            <input type="date" id="edit-deadline">
            <label>Priority</label>
            <select id="edit-priority">
                <option value="high">High</option>
                <option value="medium">Medium</option>
                <option value="low">Low</option>
            </select>
            <button id="save-btn">Save</button>
            <button id="close-btn">Close</button>
        </div>
    <!-- <script src="/script.js"></script> -->
    <script src="/script.js"></script>

</body>
</html>