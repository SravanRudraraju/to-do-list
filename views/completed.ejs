<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Completed Tasks</title>
    <link rel="stylesheet" href="/completed.css">
</head>
<body>

    <div class="completed-container">

        <h1>Completed Tasks</h1>

        <a href="/">← Back to Tasks</a>

        <table class="completed-table">

            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Priority</th>
                    <th>Deadline</th>
                    <th>Undo</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>

            <tbody>
                <% for(let i=0; i<tasks.length; i++){ %>

                <tr>

                    <td>
                        <a href="/task/<%= tasks[i].id %>">
                            <%= tasks[i].title %>
                        </a>
                    </td>

                    <td><%= tasks[i].description %></td>

                    <td><%= tasks[i].priority %></td>

                    <td>
                        <%= tasks[i].deadline.toLocaleDateString() %>
                    </td>

                    <td>
                        <input
                            type="checkbox"
                            class="undo-checkbox"
                            data-id="<%= tasks[i].id %>"
                        >
                    </td>

                    <td>
                        <button class="edit-btn" data-id="<%= tasks[i].id %>" data-title="<%= tasks[i].title %>"
                        data-description="<%= tasks[i].description %>" data-priority="<%= tasks[i].priority %>"
                        data-deadline="<%= tasks[i].deadline.toISOString().split('T')[0] %>">
                        Edit
                    </button>
                    </td>

                    <td>
                        <form action="/delete/<%= tasks[i].id %>" method="post">
                            <button type="submit">Delete</button>
                        </form>
                    </td>

                </tr>

                <% } %>

            </tbody>

        </table>

    </div>
<div id="edit-modal">
        <div id="edit-modal-content">
            <h2>Edit Task</h2>
            <input type="hidden" id="edit-id">
            <label>Title</label>
            <input type="text" id="edit-title">
            <label>Description</label>
            <textarea id="edit-description"></textarea>
            <label>Deadline</label>
            <input type="date" id="edit-deadline">
            <label>Priority</label>
            <select id="edit-priority">
                <option value="high">High</option>
                <option value="medium">Medium</option>
                <option value="low">Low</option>
            </select>
            <button id="save-btn">Save</button>
            <button id="close-btn">Close</button>
        </div>
    <!-- <script src="/script.js"></script> -->
    <script src="/script.js"></script>

</body>
</html>