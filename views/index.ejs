<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="top-controls">
        <div class="theme-toggle">
            <input type="checkbox" id="theme-switch">
            <label for="theme-switch" class="switch"></label>
        </div>
        <a href="/logout" class="logout-btn">
            Logout
        </a>
    </div>

    <div class="main-container">
        <div class="form-container">
            <h1>Task Manager</h1>
            <form action="/add-task" method="post">
                <label for="title">task name</label>
                <input type="text" name="title" maxlength="45" required>
                <label for="description">description</label>
                <textarea name="description" id="" rows="5" cols="30"></textarea>
                <label for="deadline">deadline</label>
                <input type="date" name="deadline" required>
                <label for="priority">priority</label>
                <select name="priority"  required>
                    <option value="" selected disabled>Select Priority</option>

                    <option value="high">high</option>
                    <option value="medium">medium</option>
                    <option value="low">low</option>
                </select>
                <button type="submit" class="add-task">add task</button>
            </form>
        </div>
        <div class="tasks-container">
            <h1>List of tasks</h1>
            <div class="tasks-toolbar">
                <div class="priority-legend">
                    <span class="legend high-dot">High</span>
                    <span class="legend medium-dot">Medium</span>
                    <span class="legend low-dot">Low</span>
                </div>
                <div class="sort-menu">

                    <button id="sort-btn">⇅</button>

                    <div id="sort-options">
                        <div data-sort="default"> Default</div>
                        <div data-sort="deadline">Nearest Deadline</div>
                        <div data-sort="priority">Priority</div>
                    </div>

                </div>
            </div>
            <% for(var i=0;i<tasks.length;i++){ %>

                <div class="task-card <%= tasks[i].priority %>">

                    <span>
                        <input type="checkbox" class="complete-checkbox" data-id="<%= tasks[i].id %>">
                    </span>

                    <span class="task-title" data-title="<%= tasks[i].title %>"
                        data-description="<%= tasks[i].description %>"
                        data-deadline="<%= tasks[i].deadline.toLocaleDateString() %>">
                        <%= tasks[i].title %>
                    </span>

                    <span class="task-date">
                        <%= tasks[i].deadline.toLocaleDateString() %>
                    </span>
                    <button class="edit-btn" data-id="<%= tasks[i].id %>" data-title="<%= tasks[i].title %>"
                        data-description="<%= tasks[i].description %>" data-priority="<%= tasks[i].priority %>"
                        data-deadline="<%= tasks[i].deadline.toISOString().split('T')[0] %>">
                        Edit
                    </button>

                </div>

                <% } %>
                    <div class="completed-page">
                        <a href="/completed">click here to show completed tasks</a>
                    </div>
        </div>
    </div>


    </div>
    <div id="edit-modal">
        <div id="edit-modal-content">
            <h2>Edit Task</h2>
            <input type="hidden" id="edit-id">
            <label>Title</label>
            <input type="text" id="edit-title" maxlength="45">
            <label>Description</label>
            <textarea id="edit-description"></textarea>
            <label>Deadline</label>
            <input type="date" id="edit-deadline">
            <label>Priority</label>
            <select id="edit-priority">
                <option value="high">High</option>
                <option value="medium">Medium</option>
                <option value="low">Low</option>
            </select>
            <button id="save-btn">Save</button>
            <button id="close-btn">Close</button>
        </div>

    </div>
    <div id="description-modal">

        <div id="description-modal-content">

            <!-- <h2>Description</h2> -->
            <h2 id="description-title"></h2>

            <p id="description-text"></p>

            <p id="description-deadline"></p>





        </div>
        <script src="/script.js"></script>
</body>

</html>